<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/green_border"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AJON ADMIN"
            android:textColor="#00FF00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOURLY PASSWORD GENERATOR"
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- SCROLLABLE TABS: This ensures the Admin tab is ALWAYS visible -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnTabHome"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home" />

                <Button
                    android:id="@+id/btnTabSchedule"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hourly" />

                <Button
                    android:id="@+id/btnTabTwoDay"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2-Day" />

                <Button
                    android:id="@+id/btnTabLogs"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logs" />

                <Button
                    android:id="@+id/btnTabAdmin"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <!-- ================= HOME TAB ================= -->
        <LinearLayout
            android:id="@+id/llHomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOCKED"
                android:textColor="#00FF00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:-- left this hour"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPastPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Previous: --------"
                android:textColor="#CC0000"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnCopyCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COPY CURRENT PASSWORD"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

        <!-- ================= HOURLY TAB ================= -->
        <LinearLayout
            android:id="@+id/llScheduleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llPasswordList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ================= 2-DAY TAB ================= -->
        <LinearLayout
            android:id="@+id/llTwoDayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2-DAY PASSWORD SCHEDULE (UGX 2500)"
                android:textColor="#00FF00"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/llTwoDayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ================= LOGS TAB ================= -->
        <LinearLayout
            android:id="@+id/llLogsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="People in Queue: 0"
                android:textColor="#FFAA00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDailyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sent Today: 0 / 150"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvTotalMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Received: UGX 0"
                android:textColor="#00FF00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/llTransactionLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ================= ADMIN TAB ================= -->
        <LinearLayout
            android:id="@+id/llAdminContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Panel"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etAdminPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Admin PIN"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnUnlockAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCK ADMIN" />

            <TextView
                android:id="@+id/tvAdminStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Locked"
                android:textColor="#FF4444"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START 24/7 ACTIVATOR"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
